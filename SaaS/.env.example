# Supabase Configuration
# Copy this file to .env and fill in your values

# API URL - For local: http://127.0.0.1:54421, For prod: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon Key - Get from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key - NEVER expose to client, server-side only
SUPABASE_SERVICE_ROLE_KEY=

# Direct Database URL - For migrations and server-side database access
DATABASE_URL=

# JWT Secret - For token verification (optional, usually not needed in apps)
SUPABASE_JWT_SECRET=

# GraphQL URL (optional)
NEXT_PUBLIC_SUPABASE_GRAPHQL_URL=

# Storage URL (optional, defaults to NEXT_PUBLIC_SUPABASE_URL/storage/v1)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# S3 Storage (optional, for advanced storage configs)
S3_STORAGE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Studio URL (local only, for admin panel)
SUPABASE_STUDIO_URL=

# Inbucket URL (local only, for email testing)
INBUCKET_URL=

# Stripe Configuration
# PRODUCTION: Use live keys (pk_live_xxx and sk_live_xxx)
# DEVELOPMENT: Use test keys (pk_test_xxx and rk_test_xxx)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Webhook signing secret
# LOCAL: Get via: stripe listen --print-secret
# PRODUCTION: Get from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=

# Stripe pricing/product IDs
# Create products in Stripe Dashboard > Products
# Pro tier - $14.99/month or $143.90/year
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_YEARLY=
# Enterprise tier - $99.99/month or $959.90/year
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ID_ENTERPRISE_YEARLY=

# OpenRouter Configuration
# Get API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
